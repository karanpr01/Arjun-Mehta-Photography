# Copy this file to ".env" and fill in your own value. ".env" is ignored by Git.
# The Formspree form ID is the short code at the end of your form's URL: https://formspree.io/f/THIS_PART
# Leave it empty to run the form in demo mode (nothing is sent).
VITE_FORMSPREE_FORM_ID=

# The public web address of the site, with no slash at the end. Used for canonical links,
# share previews and the sitemap. Set it to your real address when you deploy.
VITE_SITE_URL=https://example.com